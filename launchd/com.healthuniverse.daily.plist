<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily Gemma ingestion + Claude adjudication.
     Install:
       cp launchd/com.healthuniverse.daily.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.healthuniverse.daily.plist
     Logs to data/logs/daily.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.healthuniverse.daily</string>
  <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>cd /Users/michalai/HealthUniverse &amp;&amp; ./launchd/run-daily.sh</string>
    </array>
  <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>   <integer>5</integer>
      <key>Minute</key> <integer>15</integer>
    </dict>
  <key>RunAtLoad</key>        <false/>
  <key>StandardOutPath</key>  <string>/Users/michalai/HealthUniverse/data/logs/daily.log</string>
  <key>StandardErrorPath</key><string>/Users/michalai/HealthUniverse/data/logs/daily.log</string>
</dict>
</plist>
