<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.healthuniverse.burst-night2</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/michalai/HealthUniverse/scripts/run_burst.sh</string>
    <string>2</string>
  </array>

  <!-- Fire on the next 7th of any month at 22:00. The wrapper script
       removes this plist after running, so it fires exactly once. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>7</integer>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/michalai/HealthUniverse/data/audits/burst-night2.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/michalai/HealthUniverse/data/audits/burst-night2.launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
