{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{web/**,data/**,schema.sql,db.py,digest_send.py,profile.py}"
      }
    },
    { "src": "web/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/web/static/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "crons": [
    { "path": "/api/cron/digest", "schedule": "0 7 * * SUN" }
  ]
}
