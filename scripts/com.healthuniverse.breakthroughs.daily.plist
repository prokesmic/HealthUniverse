<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: daily breakthroughs ingestion via local Gemma.
  Install with:
    cp scripts/com.healthuniverse.breakthroughs.daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.healthuniverse.breakthroughs.daily.plist
  Logs land in /tmp/healthuniverse-breakthroughs.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.healthuniverse.breakthroughs.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/michalai/HealthUniverse/scripts/breakthroughs_chain.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/michalai/HealthUniverse</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/healthuniverse-breakthroughs.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/healthuniverse-breakthroughs.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
