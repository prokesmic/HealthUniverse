{
  "schema_version": 1,
  "comment": "Lab name aliases + reference ranges + entity-slug mapping. Each lab has: aliases (user-typed strings), units, ref_low / ref_high (adult population), and high_slug / low_slug pointing to entities in our graph that fire when the value is out of range. Multiple slug names allowed; we surface every matching edge.",
  "labs": {
    "tsh": {
      "name": "TSH (thyroid stimulating hormone)",
      "aliases": ["tsh", "thyroid stimulating hormone", "thyrotropin"],
      "unit": "mIU/L",
      "ref_low": 0.4, "ref_high": 4.0,
      "high_entities": ["tsh_high", "subclinical_hypothyroid"],
      "low_entities":  ["tsh_low", "hyperthyroid"],
      "category": "thyroid",
      "explainer": "Thyroid stimulating hormone — elevated values suggest the thyroid isn't producing enough T4/T3, low values suggest excess thyroid hormone. Often the first thyroid test ordered."
    },
    "free_t4": {
      "name": "Free T4",
      "aliases": ["free t4", "ft4", "free thyroxine"],
      "unit": "ng/dL",
      "ref_low": 0.8, "ref_high": 1.8,
      "high_entities": ["hyperthyroid"],
      "low_entities":  ["hypothyroid"],
      "category": "thyroid"
    },
    "ldl_c": {
      "name": "LDL cholesterol",
      "aliases": ["ldl", "ldl-c", "ldl cholesterol", "ldl-cholesterol"],
