      "ref_low": 0, "ref_high": 75,
      "high_entities": ["lpa_high"],
      "low_entities":  [],
      "category": "lipids",
      "explainer": "Largely genetic; tested once, doesn't change much with lifestyle. Elevated Lp(a) is independently linked to atherosclerosis and aortic stenosis."
    },
    "hba1c": {
      "name": "HbA1c",
      "aliases": ["hba1c", "a1c", "glycated hemoglobin"],
      "unit": "%",
      "ref_low": 4.0, "ref_high": 5.6,
      "high_entities": ["hba1c_high", "hba1c"],
      "low_entities":  [],
      "category": "metabolic",
      "explainer": "Reflects average blood glucose over ~3 months. ≥6.5% is diabetes; 5.7-6.4% is prediabetes. Trajectory matters as much as snapshot."
    },
