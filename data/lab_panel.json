      "ref_low": 0, "ref_high": 100,
      "high_entities": ["ldl_cholesterol", "ldl_c"],
      "low_entities":  [],
      "category": "lipids",
      "explainer": "Low-density lipoprotein cholesterol — the primary lipid target for cardiovascular risk. Optimal varies by overall risk; <70 mg/dL for established CVD, <100 for primary prevention."
    },
    "hdl_c": {
      "name": "HDL cholesterol",
      "aliases": ["hdl", "hdl-c", "hdl cholesterol"],
