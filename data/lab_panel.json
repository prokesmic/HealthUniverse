    "apob": {
      "name": "ApoB",
      "aliases": ["apob", "apolipoprotein b", "apo b"],
      "unit": "mg/dL",
      "ref_low": 0, "ref_high": 90,
      "high_entities": ["apob"],
      "low_entities":  [],
      "category": "lipids",
      "explainer": "ApoB counts every atherogenic particle (LDL, VLDL, IDL, Lp(a)) — increasingly seen as a better risk marker than LDL-C alone. Levels under 80 mg/dL are commonly recommended for optimal cardiovascular risk."
    },
    "lpa": {
      "name": "Lipoprotein(a)",
